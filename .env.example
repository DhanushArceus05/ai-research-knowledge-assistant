# ============================================================================
# Core application
# ============================================================================
APP_NAME=AI Research & Knowledge Assistant
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# ============================================================================
# Database (SQLite by default; any SQLAlchemy-compatible URL works, e.g.
# postgresql+psycopg2://user:pass@host:5432/dbname for Postgres)
# ============================================================================
DATABASE_URL=sqlite:///./data/app.db

# ============================================================================
# Storage
# ============================================================================
UPLOAD_DIR=./data/raw_documents
VECTOR_DB_DIR=./data/vector_db
IMAGES_DIR=./data/extracted_images

# ============================================================================
# TensorFlow document classifier artifacts
# ============================================================================
MODEL_PATH=./models/document_classifier.keras
VECTORIZER_PATH=./models/text_vectorizer.pkl
LABEL_ENCODER_PATH=./models/label_encoder.pkl

# ============================================================================
# Google Gemini (required for RAG answers, summarization, comparison,
# streaming, and the agent's answer/summarize/compare tools)
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# Embeddings (downloaded from Hugging Face on first use; requires outbound
# internet access once, then cached locally)
# ============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# Chunking / retrieval
# ============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RESULTS=4
MAX_UPLOAD_SIZE_MB=20
MAX_HISTORY_MESSAGES=8

# ============================================================================
# Authentication (JWT). NEVER use these placeholder values in production --
# generate a real random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# OCR (optional; app works fine without Tesseract installed -- scanned pages
# are simply reported as unavailable for OCR rather than crashing anything)
# ============================================================================
OCR_ENABLED=true
OCR_TEXT_THRESHOLD=40
OCR_LANGUAGE=eng
OCR_DPI=300
# Only set TESSERACT_CMD if Tesseract isn't on PATH (e.g. a custom Windows install path):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ============================================================================
# Reranking (optional second-stage cross-encoder; requires one-time model
# download from Hugging Face -- falls back gracefully to fused ranking if
# unavailable, e.g. no internet access)
# ============================================================================
RERANKING_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_COUNT=12

# Hybrid retrieval candidate pool sizes and Reciprocal Rank Fusion constant
HYBRID_DENSE_CANDIDATES=15
HYBRID_SPARSE_CANDIDATES=15
RRF_K=60

# ============================================================================
# Caching. The in-process memory cache always works; set CACHE_BACKEND=redis
# with a reachable REDIS_URL to use Redis instead. If Redis is configured but
# unreachable, the app automatically and silently falls back to the memory
# cache -- Redis is never required to start the application.
# ============================================================================
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Research agent
# ============================================================================
AGENT_MAX_STEPS=5

# ============================================================================
# Streaming
# ============================================================================
STREAMING_ENABLED=true
